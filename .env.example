# ConsentTrace environment variables.
# Copy to .env and fill in real values. Never commit real secrets.
# Server-only variables must never be exposed to client bundles.

# --- Database (server-only) ---
# Postgres connection string. Separate databases per environment (dev/staging/prod).
# Local development: `npm run dev -w @consenttrace/database` boots embedded PG 17 at:
DATABASE_URL=postgres://ct:ct@127.0.0.1:5433/consenttrace

# --- Web app / runner ---
# Evidence storage directory (local adapter; production uses object storage).
CT_STORAGE_DIR=./storage
# Set true to disable the in-process scan runner (dedicated workers claim the queue instead).
CT_DISABLE_RUNNER=false
# Allow *.fixture.test / fixture tracker hosts as scan targets (dev/demo ONLY — keep false in prod).
CT_ALLOW_FIXTURE_TARGETS=true
# Owner-only dev plan switching; ignored/refused in production builds.
CT_BILLING_DEV_MODE=true

# --- Supabase (when wired; server-only unless prefixed NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Object storage for evidence artifacts (server-only) ---
EVIDENCE_STORAGE_BUCKET=consenttrace-evidence-dev
EVIDENCE_SIGNED_URL_TTL_SECONDS=300

# --- Worker ---
# Directory scan artifacts are written to before upload.
WORKER_OUTPUT_DIR=./scan-output
# Hard per-scan timeout in ms.
WORKER_SCAN_TIMEOUT_MS=180000
# NEVER enable outside local development/CI fixtures. Disables SSRF private-target blocking.
WORKER_ALLOW_PRIVATE_TARGETS=false

# --- Billing / Stripe (server-only). Without keys, billing runs in dev mode. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# --- App ---
# Public base URL used in emails and Stripe redirect URLs.
APP_BASE_URL=http://localhost:3000
# Unverified sites are capped at this many scans per month (domain verification lifts it).
CT_UNVERIFIED_SITE_MONTHLY_CAP=10

# --- AI (Phase 2; server-only) ---
AI_PROVIDER_API_KEY=
AI_MAX_CALLS_PER_SCAN=10

# --- Email notifications (server-only) ---
# "log" (default: structured console output) or "resend" (requires key + from address).
EMAIL_PROVIDER=log
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=notifications@example.com
